{
  "name": "family-graph-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 9056 --strictPort",
    "build": "vue-tsc && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "lint": "eslint \"src/**/*.{ts,vue}\" \"test/**/*.ts\"",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "python -m unittest discover -s e2e -p test_*.py -v"
  },
  "dependencies": {
    "element-plus": "^2.8.0",
    "vue": "^3.5.0",
    "vue-router": "^4.4.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.32.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.5.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.1.0"
  }
}
